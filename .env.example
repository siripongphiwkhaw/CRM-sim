# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# --- Database (required) ---
# Neon Postgres connection string. Pooled endpoint is fine for the HTTP driver.
DATABASE_URL=

# --- Session (optional) ---
# Falls back to a built-in demo key when unset. Must be at least 32 characters.
SESSION_SECRET=

# --- Sensitive personal data (required only to capture identity numbers) ---
# Encrypts the 13-digit national ID at the application layer (AES-256-GCM), so
# the plaintext never sits in a row, a DB dump, or a support query. Under PDPA
# a national ID is sensitive personal data; a corporate tax ID is not.
#
# Either 64 hex characters (a real 32-byte key) or any strong passphrase, which
# is stretched with scrypt. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# FAIL CLOSED: with this unset, storing an identity number is refused outright
# rather than written as plaintext. Leaving it blank simply disables the
# feature — everything else runs normally.
PII_ENCRYPTION_KEY=

# --- REST API (optional) ---
# When set, /api/v1 routes accept `Authorization: Bearer <this>` in addition to
# a signed-in staff session.
CRM_API_KEY=

# --- Only-One LINE mini-app (optional) ---
# From the LINE Developers console: create a LINE Login channel, add a LIFF app
# with the endpoint URL pointing at <your-domain>/liff and size "Full".
#
# IMPORTANT: enable BOTH the `profile` and `openid` scopes on the channel.
# Without `openid`, liff.getIDToken() returns null and sign-in cannot work.
#
# Public — inlined into the browser bundle at build time. Not a secret; it is
# already visible in the https://liff.line.me/<id> URL.
NEXT_PUBLIC_LIFF_ID=
# Server-only. Used as `client_id` when verifying an ID token with LINE.
LINE_CHANNEL_ID=

# Local development only. Set to 1 to enable the demo member picker at
# /liff/dev when LINE is not configured. Ignored in production builds and
# automatically disabled once NEXT_PUBLIC_LIFF_ID + LINE_CHANNEL_ID are set.
LIFF_DEV_FALLBACK=

# --- Receipt OCR (optional) ---
# Scanning runs free in-browser via Tesseract by default. Set this to switch to
# higher-accuracy Claude vision instead (paid).
ANTHROPIC_API_KEY=
